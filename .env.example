# Application
APP_NAME="Teacha"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Runtime
PHP_CLI_SERVER_WORKERS=4

# Database
DB_CONNECTION=mysql
DB_DATABASE=stockflow
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_USERNAME=null
REDIS_PASSWORD=null

# Mail
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Integrations
SLACK_BOT_USER_OAUTH_TOKEN=

# AI assistant
AI_ASSISTANT_ENABLED=false

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_SMOKE_TEST=false

# AI assistant limits
AI_ASSISTANT_PROMPT_MAX_CHARACTERS=10000
AI_ASSISTANT_MAX_STEPS=12
AI_ASSISTANT_TIMEOUT_SECONDS=120
AI_ASSISTANT_RATE_LIMIT_PER_MINUTE=20
AI_ASSISTANT_TOOL_RESULT_LIMIT=50
AI_ASSISTANT_TOOL_RESULT_MAX_BYTES=65536
AI_ASSISTANT_CONTEXT_MAX_ROWS=300
AI_ASSISTANT_CONTEXT_MAX_CHARACTERS=500000

# Network and session
TRUSTED_PROXIES=127.0.0.1
SESSION_SECURE_COOKIE=false
